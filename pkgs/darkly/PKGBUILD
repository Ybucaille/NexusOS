# Based on the AUR darkly recipe (maintainer: DeltaCopy).
# Built from source instead of darkly-bin; pinned to 0.5.39, the version
# validated with the Caelestia dots. Provides darkly-bin, which the dots
# manifest names.

pkgname=darkly
pkgver=0.5.39
pkgrel=1
pkgdesc='Fork of Lightly, a modern style for Qt applications'
arch=(x86_64)
url='https://github.com/Bali10050/darkly'
license=('GPL-2.0-or-later')
depends=(kdecoration qt6-declarative kcoreaddons kcmutils kcolorscheme kconfig kguiaddons
         kiconthemes kwindowsystem frameworkintegration libplasma)
makedepends=(cmake extra-cmake-modules)
provides=(darkly-bin)
conflicts=(darkly-bin)
options=(!emptydirs)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5fed786f78ac3a6153e99920e722c981348c01fc781fb511371f6bfedee0f0c2')

build() {
  cmake -S "Darkly-$pkgver" -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -DBUILD_QT6=ON \
    -DBUILD_QT5=OFF \
    -Wno-author
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -rf "$pkgdir/usr/lib/cmake"
}
