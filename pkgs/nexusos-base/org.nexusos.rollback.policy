<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- pkexec nexusos-rollback, as the desktop shell runs it to go back or to
     clean up. Rare and heavy, so the administrator password is asked every
     time (no _keep). -->
<policyconfig>
  <vendor>NexusOS</vendor>
  <vendor_url>https://github.com/Ybucaille/NexusOS</vendor_url>
  <action id="org.nexusos.rollback">
    <description>Go back to a NexusOS snapshot or delete an old system</description>
    <description xml:lang="fr">Revenir à un snapshot de NexusOS ou supprimer un ancien système</description>
    <message>Authentication is required to go back to a snapshot of NexusOS or to delete an old system</message>
    <message xml:lang="fr">Une authentification est nécessaire pour revenir à un snapshot de NexusOS ou supprimer un ancien système</message>
    <icon_name>nexusos-logo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/nexusos-rollback</annotate>
  </action>
</policyconfig>
