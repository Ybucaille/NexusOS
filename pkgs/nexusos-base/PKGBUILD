# NexusOS base system: identity (os-release, logo), nexusos-update (and its
# channel), boot entries for snapper snapshots, their list for the desktop shell
# and nexusos-rollback.
# filesystem keeps owning /usr/lib/os-release; a pacman hook writes NexusOS's
# over it after every filesystem upgrade, as Arch derivatives do rather than
# forking filesystem.

pkgname=nexusos-base
pkgver=0.8.2
pkgrel=1
pkgdesc='NexusOS base system: identity (os-release, logo), updates, snapshot boot entries and rollback'
arch=(any)
url='https://github.com/Ybucaille/NexusOS'
license=('GPL-3.0-only')
depends=(filesystem bash curl gnupg nexusos-keyring pacman tar zstd)
optdepends=('snapper: a snapshot before and after each update'
            'limine: boot entries for the snapshots'
            'mkinitcpio: booting a read-only snapshot'
            'btrfs-progs: going back to a snapshot for good (nexusos-rollback)'
            'polkit: updates and rollback from the desktop shell (pkexec)')
backup=(etc/nexusos/update.conf etc/mkinitcpio.conf.d/nexusos.conf)
source=(os-release nexusos-logo.svg nexusos-os-release.hook nexusos-update pacman-retry update.conf
        boot-snapshots snapper-plugin initcpio-install initcpio-hook mkinitcpio.conf
        org.nexusos.update.policy nexusos-rollback org.nexusos.rollback.policy nexusos-snapshots.service)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm644 os-release -t "$pkgdir/usr/share/nexusos"
  # Found by name through LOGO=, like Arch's archlinux-logo.
  install -Dm644 nexusos-logo.svg -t "$pkgdir/usr/share/pixmaps"
  install -Dm644 nexusos-os-release.hook -t "$pkgdir/usr/share/libalpm/hooks"
  install -Dm755 nexusos-update nexusos-rollback -t "$pkgdir/usr/bin"
  install -Dm755 pacman-retry -t "$pkgdir/usr/lib/nexusos"
  install -Dm644 update.conf -t "$pkgdir/etc/nexusos"
  install -Dm644 org.nexusos.update.policy org.nexusos.rollback.policy -t "$pkgdir/usr/share/polkit-1/actions"
  install -Dm755 boot-snapshots -t "$pkgdir/usr/lib/nexusos"
  install -Dm644 nexusos-snapshots.service -t "$pkgdir/usr/lib/systemd/system"
  # Enabled by the package, as some Arch packages do: the unit only runs where
  # /.snapshots exists.
  install -dm755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../nexusos-snapshots.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/nexusos-snapshots.service"
  # snapper runs its plugins in name order; the name must start with a digit.
  install -Dm755 snapper-plugin "$pkgdir/usr/lib/snapper/plugins/50-nexusos-boot"
  install -Dm644 initcpio-install "$pkgdir/usr/lib/initcpio/install/nexusos-snapshot"
  install -Dm644 initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/nexusos-snapshot"
  install -Dm644 mkinitcpio.conf "$pkgdir/etc/mkinitcpio.conf.d/nexusos.conf"
}
