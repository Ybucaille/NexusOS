# Based on the AUR caelestia-shell recipe (maintainer: Soramane).
# Built from the release source with two patches validated on 2026-10-20:
#   01: destroy finished Nmcli CommandProcess objects (leak).
#   02: null-safe reads in notifications.
# The native plugin links against Qt and Quickshell: rebuild it with them.

pkgname=caelestia-shell
pkgver=2.5.0
pkgrel=1
pkgdesc='The desktop shell for the Caelestia dotfiles'
arch=(x86_64)
url='https://github.com/caelestia-dots/shell'
license=('GPL-3.0-only')
depends=(caelestia-cli quickshell-git glibc gcc-libs
         ddcutil brightnessctl
         libcava networkmanager lm_sensors aubio libpipewire libqalculate power-profiles-daemon
         ttf-material-symbols-variable ttf-rubik-vf ttf-cascadia-code-nerd
         qt6-base qt6-declarative qt6-imageformats qt6-m3shapes-git
         swappy fish bash)
optdepends=('asdbctl: controlling the brightness of Apple Studio Displays'
            'fprintd: fingerprint unlock for the lock screen'
            'howdy-next: face unlock for the lock screen')
makedepends=(cmake ninja qt6-shadertools)
provides=("$pkgname")
conflicts=("$pkgname-git")
_src=$pkgname-v$pkgver
source=("$url/releases/download/v$pkgver/$_src.tar.gz"
        01-nmcli-commandprocess-destroy.patch
        02-notification-null-guards.patch)
sha256sums=('6bef9feff9f9c6afeb6fdf0b9bb1cfc3cfd7dff4c2a020e8079d6720975f3b6a'
            'd2a16b45791ac647ba3b51e3a3ab14b1f55d005bfe66a3d52cad30aa11b768e8'
            '5cb227dc9ba31d52dc6842d361ac87d33667f491e6f0e15e2c7524d5f347143c')

prepare() {
  cd "$_src"
  for p in "$srcdir"/0*.patch; do
    patch --batch --fuzz=0 --forward -p1 < "$p"
  done
}

build() {
  cd "$_src"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/ \
    -DVERSION=$pkgver \
    -DGIT_REVISION="$(cat REVISION)" \
    -DDISTRIBUTOR="NexusOS (package: $pkgname)"
  cmake --build build
}

package() {
  cd "$_src"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
