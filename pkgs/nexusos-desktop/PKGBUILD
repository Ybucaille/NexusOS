# NexusOS desktop: the session, the pinned Caelestia dots deployment and the
# packages of every enabled dots component (the 18 defaults plus uwsm).

pkgname=nexusos-desktop
pkgver=0.1.0
pkgrel=2
pkgdesc='NexusOS desktop session: Hyprland with the Caelestia shell'
arch=(any)
url='https://github.com/Ybucaille/NexusOS'
license=('GPL-3.0-only')
depends=(
  # Session
  nexusos-base greetd greetd-tuigreet uwsm caelestia-dots python
  # Dots components, from the pinned manifest
  caelestia-shell caelestia-cli
  hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk ttf-jetbrains-mono-nerd
  fish eza zoxide direnv foot fastfetch btop micro thunar starship
  firefox caelestia-firefox-theme
  adw-gtk-theme papirus-icon-theme papirus-folders qtengine frameworkintegration darkly-bin
  gnome-keyring polkit-gnome networkmanager bluez bluez-utils
  pipewire pipewire-pulse pipewire-audio pipewire-alsa pipewire-jack wireplumber pwvucontrol
  wl-clipboard cliphist noto-fonts noto-fonts-cjk noto-fonts-emoji
  curl git trash-cli jq lazygit bat ripgrep ydotool hyprpicker xdg-user-dirs
)
source=(nexusos-session dots dots-pending nexusos-dots.service nexusos-dots.path nexusos.desktop greetd.toml)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm755 nexusos-session -t "$pkgdir/usr/bin"
  install -Dm755 dots dots-pending -t "$pkgdir/usr/lib/nexusos"
  install -Dm644 nexusos-dots.service nexusos-dots.path -t "$pkgdir/usr/lib/systemd/user"
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../nexusos-dots.service ../nexusos-dots.path "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
  install -Dm644 nexusos.desktop -t "$pkgdir/usr/share/wayland-sessions"
  # greetd owns /etc/greetd/config.toml; the ISO and installer copy this one.
  install -Dm644 greetd.toml "$pkgdir/usr/share/nexusos/greetd.toml"
}
