# Same hooks as archlinux-keyring: trust the keys once pacman's keyring exists.
post_upgrade() {
  if usr/bin/pacman-key -l >/dev/null 2>&1; then
    usr/bin/pacman-key --populate nexusos
    usr/bin/pacman-key --updatedb
  fi
}

post_install() {
  if [ -x usr/bin/pacman-key ]; then
    post_upgrade
  fi
}
